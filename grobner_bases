# PART 3: BB CODE CONSTRUCTION
# ============================================================================

@dataclass
class BBCode:
    """BB Code representation"""
    ell: int
    m: int
    A: List[int]  # Coefficients of polynomial A
    B: List[int]  # Coefficients of polynomial B
    H_X: np.ndarray
    H_Z: np.ndarray
    H: np.ndarray
    n: int
    r: int

def poly_to_circulant(coeffs: List[int], size: int) -> np.ndarray:
    """Convert polynomial coefficients to circulant matrix"""
    # Pad coefficients if needed
    if len(coeffs) < size:
        coeffs = coeffs + [0] * (size - len(coeffs))
    
    # Build circulant matrix
    mat = np.zeros((size, size), dtype=int)
    for i in range(size):
        for j in range(size):
            mat[i, j] = coeffs[(j - i) % size]
    return mat % 2

def construct_bb_code(ell: int, m: int, A_coeffs: List[int], B_coeffs: List[int]) -> BBCode:
    """Construct BB code from polynomials"""
    # Convert polynomials to circulant matrices
    A = poly_to_circulant(A_coeffs, ell * m)
    B = poly_to_circulant(B_coeffs, ell * m)
    
    # H_X = [A | B]
    H_X = np.hstack([A, B])
    
    # H_Z = [B^T | A^T]
    H_Z = np.hstack([B.T, A.T])
    
    # Full check matrix for CSS code
    r_X = H_X.shape[0]
    r_Z = H_Z.shape[0]
    n = H_X.shape[1]
    
    # Combine into full H
    H = np.zeros((r_X + r_Z, 2 * n), dtype=int)
    H[:r_X, :n] = H_X
    H[r_X:, n:] = H_Z
    
    return BBCode(
        ell=ell,
        m=m,
        A=A_coeffs,
        B=B_coeffs,
        H_X=H_X,
        H_Z=H_Z,
        H=H,
        n=n,
        r=2 * n
    )

# ============================================================================
# PART 4: DECODING ALGORITHM
# ============================================================================

class AlgebraicDecoder:
    """Algebraic geometry decoder for BB codes"""
    
    def __init__(self, code: BBCode):
        self.code = code
        self.n = code.n
        self.r = code.r
        
        # Number of variables in polynomial ring
        self.num_vars = 2 * self.n  # Error vector for both X and Z errors
    
    def _build_polynomial_ring(self):
        """Build polynomial ring with lex order"""
        self.vars = [f'e{i}' for i in range(self.num_vars)]
        # We'll use a dictionary representation instead of a formal ring
    
    def _build_syndrome_equations(self, syndrome: np.ndarray) -> List[Polynomial]:
        """Build syndrome equations from H and syndrome"""
        equations = []
        H = self.code.H
        
        for j in range(H.shape[0]):
            # Build equation: sum_i H[j,i] * e_i = s_j
            terms = {}
            for i in range(H.shape[1]):
                if H[j, i] == 1:
                    # Create monomial e_i
                    exp = [0] * self.num_vars
                    exp[i] = 1
                    terms[Monomial(tuple(exp))] = 1
            
            # Add syndrome term (constant)
            if syndrome[j] == 1:
                terms[Monomial(tuple([0] * self.num_vars))] = 1
            
            if terms:
                equations.append(Polynomial(terms))
        
        return equations
    
    def _add_binary_constraints(self) -> List[Polynomial]:
        """Add binary constraints e_i^2 + e_i = 0"""
        constraints = []
        for i in range(self.num_vars):
            # e_i^2 + e_i = 0
            exp1 = [0] * self.num_vars
            exp1[i] = 2
            exp2 = [0] * self.num_vars
            exp2[i] = 1
            
            terms = {
                Monomial(tuple(exp1)): 1,
                Monomial(tuple(exp2)): 1
            }
            constraints.append(Polynomial(terms))
        
        return constraints
    
    def _extract_solution(self, grobner_basis: List[Polynomial]) -> Optional[np.ndarray]:
        """Extract solution from Gröbner basis"""
        solution = np.zeros(self.num_vars, dtype=int)
        
        # Find polynomials of form e_i + c = 0 or e_i = 0
        for i in range(self.num_vars - 1, -1, -1):
            found = False
            
            for poly in grobner_basis:
                if poly.is_zero():
                    continue
                
                # Check if this is a univariate polynomial in e_i
                vars_in_poly = poly.variables()
                if len(vars_in_poly) == 1 and i in vars_in_poly:
                    # Try to solve for e_i
                    for val in [0, 1]:
                        # Substitute value and check if zero
                        test_terms = {}
                        for m, c in poly.terms.items():
                            if m.exponents[i] > 0:
                                # Replace e_i with val
                                new_exp = list(m.exponents)
                                new_exp[i] = 0
                                new_m = Monomial(tuple(new_exp))
                                coeff = c * (val ** m.exponents[i])
                                if coeff % 2 == 1:
                                    test_terms[new_m] = (test_terms.get(new_m, 0) + coeff) % 2
                            else:
                                test_terms[m] = (test_terms.get(m, 0) + c) % 2
                        
                        test_poly = Polynomial(test_terms)
                        if test_poly.is_zero():
                            solution[i] = val
                            found = True
                            break
                    
                    if found:
                        break
            
            if not found:
                # Check for polynomials of form e_i + e_j (not uniquely determined)
                for poly in grobner_basis:
                    vars_in_poly = poly.variables()
                    if len(vars_in_poly) == 2 and i in vars_in_poly:
                        # Free variable - not uniquely decodable
                        return None
        
        return solution
    
    def decode(self, syndrome: np.ndarray, t: int = 1) -> Optional[np.ndarray]:
        """
        Decode the syndrome to find the error vector
        
        Args:
            syndrome: Syndrome vector
            t: Maximum number of errors to correct
        
        Returns:
            Error vector or None if not uniquely decodable
        """
        print(f"\nDecoding syndrome: {syndrome}")
        print(f"Error-correction radius: t = {t}")
        
        # Step 1: Build syndrome equations
        print("\nStep 1: Building syndrome equations...")
        equations = self._build_syndrome_equations(syndrome)
        print(f"  Found {len(equations)} syndrome equations")
        
        # Step 2: Add binary constraints
        print("Step 2: Adding binary constraints...")
        constraints = self._add_binary_constraints()
        print(f"  Added {len(constraints)} binary constraints")
        
        # Step 3: Form the ideal
        print("Step 3: Forming the ideal...")
        all_polynomials = equations + constraints
        print(f"  Total polynomials: {len(all_polynomials)}")
        
        # Step 4: Compute Gröbner basis
        print("Step 4: Computing Gröbner basis (Buchberger's algorithm)...")
        gb = GrobnerBasis(all_polynomials)
        basis = gb.get_basis()
        print(f"  Gröbner basis size: {len(basis)}")
        
        # Step 5: Extract solution
        print("Step 5: Extracting solution...")
        error_vec = self._extract_solution(basis)
        
        if error_vec is None:
            print("  Warning: Not uniquely decodable!")
            return None
        
        print(f"  Error vector: {error_vec}")
        print(f"  Error weight: {np.sum(error_vec)}")
        
        # Step 6: Verify
        print("Step 6: Verifying solution...")
        computed_syndrome = (self.code.H @ error_vec) % 2
        
        if np.array_equal(computed_syndrome, syndrome):
            print("  ✓ Verification passed!")
            
            # Check error weight
            if np.sum(error_vec) <= t:
                print(f"  ✓ Error weight ({np.sum(error_vec)}) ≤ t ({t})")
            else:
                print(f"  ⚠ Warning: Error weight ({np.sum(error_vec)}) > t ({t})")
            
            return error_vec
        else:
            print("  ✗ Verification failed!")
            return None

