# ============================================================================
# PART 1: POLYNOMIAL RING OVER GF(2) WITH LEX ORDER
# ============================================================================

class Monomial:
    """Monomial representation with exponents"""
    def __init__(self, exponents: Tuple[int, ...]):
        self.exponents = tuple(exponents)
    
    def __hash__(self):
        return hash(self.exponents)
    
    def __eq__(self, other):
        if not isinstance(other, Monomial):
            return False
        return self.exponents == other.exponents
    
    def __lt__(self, other):
        """Lexicographic order (e0 > e1 > e2 > ...)"""
        if not isinstance(other, Monomial):
            return NotImplemented
        return self.exponents > other.exponents  # Lex order
    
    def __mul__(self, other):
        if not isinstance(other, Monomial):
            return NotImplemented
        new_exp = tuple(a + b for a, b in zip(self.exponents, other.exponents))
        return Monomial(new_exp)
    
    def degree(self) -> int:
        return sum(self.exponents)
    
    def divides(self, other) -> bool:
        """Check if this monomial divides another"""
        return all(a <= b for a, b in zip(self.exponents, other.exponents))
    
    def lcm(self, other):
        """Least common multiple of two monomials"""
        new_exp = tuple(max(a, b) for a, b in zip(self.exponents, other.exponents))
        return Monomial(new_exp)

class Polynomial:
    """Polynomial over GF(2) with lex order"""
    def __init__(self, terms: Dict[Monomial, int] = None):
        self.terms = terms if terms else {}
        self._clean()
    
    def _clean(self):
        """Remove zero coefficients and combine like terms"""
        # Remove zero coefficients
        self.terms = {m: c for m, c in self.terms.items() if c % 2 == 1}
    
    def __add__(self, other):
        if not isinstance(other, Polynomial):
            return NotImplemented
        result = self.terms.copy()
        for m, c in other.terms.items():
            if m in result:
                result[m] = (result[m] + c) % 2
            else:
                result[m] = c % 2
        return Polynomial(result)
    
    def __mul__(self, other):
        if not isinstance(other, Polynomial):
            return NotImplemented
        result = defaultdict(int)
        for m1, c1 in self.terms.items():
            for m2, c2 in other.terms.items():
                m = m1 * m2
                result[m] = (result[m] + c1 * c2) % 2
        return Polynomial({m: c for m, c in result.items() if c % 2 == 1})
    
    def __sub__(self, other):
        # In GF(2), subtraction is same as addition
        return self.__add__(other)
    
    def __repr__(self):
        if not self.terms:
            return "0"
        terms_str = []
        for m, c in sorted(self.terms.items(), key=lambda x: x[0], reverse=True):
            if c == 0:
                continue
            if m.degree() == 0:
                terms_str.append("1")
            else:
                var_str = "".join([f"e{i}^{e}" if e > 1 else f"e{i}" 
                                  for i, e in enumerate(m.exponents) if e > 0])
                terms_str.append(var_str)
        return " + ".join(terms_str) if terms_str else "0"
    
    def lt(self):
        """Leading term (monomial with highest order)"""
        if not self.terms:
            return None
        return max(self.terms.keys())
    
    def lc(self):
        """Leading coefficient"""
        lt = self.lt()
        return self.terms.get(lt, 0)
    
    def lm(self):
        """Leading monomial"""
        return self.lt()
    
    def reduce_by(self, divisor):
        """Reduce polynomial by divisor"""
        if not self.terms:
            return Polynomial()
        
        result = Polynomial(self.terms.copy())
        divisor_lt = divisor.lt()
        divisor_lc = divisor.lc()
        
        while True:
            poly_lt = result.lt()
            if poly_lt is None:
                break
            if divisor_lt is not None and divisor_lt.divides(poly_lt):
                # Compute multiplier: poly_lt / divisor_lt
                multiplier_exp = tuple(a - b for a, b in zip(poly_lt.exponents, divisor_lt.exponents))
                multiplier_monomial = Monomial(multiplier_exp)
                
                # Create multiplier polynomial
                multiplier = Polynomial({multiplier_monomial: 1})
                
                # Multiply divisor by multiplier and add to result (subtract in GF(2))
                term_to_add = divisor * multiplier
                result = result + term_to_add
            else:
                break
        
        return result
    
    def is_zero(self):
        return len(self.terms) == 0
    
    def variables(self):
        """Get set of variables in this polynomial"""
        vars_set = set()
        for m in self.terms.keys():
            for i, exp in enumerate(m.exponents):
                if exp > 0:
                    vars_set.add(i)
        return vars_set

# ============================================================================
# PART 2: GROBNER BASIS COMPUTATION (BUCHBERGER'S ALGORITHM)
# ============================================================================

class GrobnerBasis:
    """Compute Gröbner basis using Buchberger's algorithm"""
    
    def __init__(self, polynomials: List[Polynomial]):
        self.polynomials = polynomials
        self.basis = []
        self._compute()
    
    def _s_polynomial(self, p: Polynomial, q: Polynomial):
        """Compute S-polynomial of p and q"""
        if p.is_zero() or q.is_zero():
            return Polynomial()
        
        lt_p = p.lt()
        lt_q = q.lt()
        
        if lt_p is None or lt_q is None:
            return Polynomial()
        
        # Compute LCM of leading monomials
        lcm = lt_p.lcm(lt_q)
        
        # Compute multipliers
        mult_p_exp = tuple(a - b for a, b in zip(lcm.exponents, lt_p.exponents))
        mult_q_exp = tuple(a - b for a, b in zip(lcm.exponents, lt_q.exponents))
        
        mult_p = Polynomial({Monomial(mult_p_exp): 1})
        mult_q = Polynomial({Monomial(mult_q_exp): 1})
        
        # S = (lcm/lt_p)*p - (lcm/lt_q)*q
        spoly = (mult_p * p) + (mult_q * q)  # In GF(2), subtraction is addition
        
        return spoly
    
    def _normal_form(self, p: Polynomial, basis: List[Polynomial]):
        """Reduce polynomial modulo the basis"""
        if p.is_zero():
            return Polynomial()
        
        result = Polynomial(p.terms.copy())
        
        while True:
            # Find a basis element that can reduce the leading term
            reduced = False
            for g in basis:
                if g.is_zero():
                    continue
                g_lt = g.lt()
                if g_lt is None:
                    continue
                
                poly_lt = result.lt()
                if poly_lt is None:
                    break
                
                if g_lt.divides(poly_lt):
                    # Compute multiplier
                    mult_exp = tuple(a - b for a, b in zip(poly_lt.exponents, g_lt.exponents))
                    mult_monomial = Monomial(mult_exp)
                    mult = Polynomial({mult_monomial: 1})
                    
                    # Reduce
                    result = result + (g * mult)
                    reduced = True
                    break
            
            if not reduced or result.is_zero():
                break
        
        return result
    
    def _compute(self):
        """Compute Gröbner basis using Buchberger's algorithm"""
        # Start with all polynomials
        G = list(self.polynomials)
        G = [p for p in G if not p.is_zero()]
        
        # Main loop
        pairs = [(i, j) for i in range(len(G)) for j in range(i+1, len(G))]
        
        while pairs:
            # Take a pair
            i, j = pairs.pop(0)
            
            # Compute S-polynomial
            spoly = self._s_polynomial(G[i], G[j])
            
            # Reduce S-polynomial modulo G
            h = self._normal_form(spoly, G)
            
            # If h is not zero, add to basis and update pairs
            if not h.is_zero():
                # Add new polynomial
                k = len(G)
                G.append(h)
                
                # Add new pairs
                for l in range(k):
                    pairs.append((l, k))
        
        # Reduce basis
        self.basis = self._interreduce(G)
    
    def _interreduce(self, basis: List[Polynomial]):
        """Interreduce the basis to make it reduced"""
        G = [p for p in basis if not p.is_zero()]
        
        # Remove redundant polynomials
        i = 0
        while i < len(G):
            p = G[i]
            reduced = self._normal_form(p, [G[j] for j in range(len(G)) if j != i])
            if reduced.is_zero():
                G.pop(i)
            else:
                G[i] = reduced
                i += 1
        
        # Make each polynomial monic
        for i, p in enumerate(G):
            lc = p.lc()
            if lc == 1:
                continue
            # In GF(2), lc is always 1 for non-zero polynomials
            # So we just need to make sure the leading coefficient is 1
            # (which it already is since we're in GF(2))
            pass
        
        return G
    
    def get_basis(self):
        return self.basis

