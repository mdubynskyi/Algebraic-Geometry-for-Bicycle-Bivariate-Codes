        B_coeffs=[1, 1, 1]
    )
    
    n = 2 * code.n
    decoder = AlgebraicDecoder(code)
    
    # Try to find minimum weight non-zero solution
    min_weight = n
    min_error = None
    
    # Test all single error patterns
    for error_pos in range(n):
        error = np.zeros(n, dtype=int)
        error[error_pos] = 1
        
        syndrome = (code.H @ error) % 2
        decoded = decoder.decode(syndrome, t=1)
        
        if decoded is not None and np.sum(decoded) > 0:
            weight = np.sum(decoded)
            if weight < min_weight:
                min_weight = weight
                min_error = decoded
    
    print(f"\nEstimated minimum distance: d ≤ {min_weight}")
    if min_error is not None:
        print(f"Minimum weight error found: {min_error}")
        print(f"Weight: {min_weight}")

