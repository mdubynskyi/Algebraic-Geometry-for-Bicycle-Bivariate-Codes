    print("  A(x) = 1 + x")
    print("  B(x) = 1 + x + x^2")
    print("  Error: single error at position 1 (e1 = 1)")
    
    # Construct the code
    print("\nConstructing BB code...")
    code = construct_bb_code(
        ell=3,
        m=1,
        A_coeffs=[1, 1, 0],  # 1 + x
        B_coeffs=[1, 1, 1]   # 1 + x + x^2
    )
    
    print(f"  Code parameters: n = {code.n}, r = {code.r}")
    print(f"  H_X shape: {code.H_X.shape}")
    print(f"  H_Z shape: {code.H_Z.shape}")
    
    # Create error at position 1
    n = 2 * code.n  # Total qubits (X and Z parts)
    error = np.zeros(n, dtype=int)
    error[1] = 1  # Error on qubit 1 (0-indexed)
    
    print(f"\nTrue error vector: {error}")
    print(f"Error weight: {np.sum(error)}")
    
    # Compute syndrome
    syndrome = (code.H @ error) % 2
    print(f"Syndrome: {syndrome}")
    
    # Decode
    decoder = AlgebraicDecoder(code)
    decoded_error = decoder.decode(syndrome, t=1)
    
    if decoded_error is not None:
        print("\n" + "=" * 70)
        print("RESULTS")
        print("=" * 70)
        print(f"True error:     {error}")
        print(f"Decoded error:  {decoded_error}")
        
